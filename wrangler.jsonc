{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "negahjavan",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "ai": {"binding": "AI"},
  "routes": [
    {"pattern": "negahjavan.ir", "custom_domain": true},
    {"pattern": "www.negahjavan.ir", "custom_domain": true}
  ],
  "vars": {
    "SITE_NAME": "نگاه جوان"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "negahjavan1-db",
      "database_id": "b547715c-791a-465c-a415-2f45cf1061c0"
    }
  ]
}

